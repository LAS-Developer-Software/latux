{
  "name": "greeting",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension",
  "browser": "./dist/browser/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "greeting.showWelcome",
        "title": "%commands.showWelcome%"
      },
      {
        "command": "greeting.changeName",
        "title": "%commands.changeName%"
      }
    ]
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "compile": "tsc -p ./",
    "webpack": "webpack --mode development",
    "webpack-prod": "webpack --mode production"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "4.5.4",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.4.0"
  }
}
